{
  "name": "byheaven-skills",
  "description": "A monorepo of harness- and model-agnostic agent plugins by Byheaven",
  "private": true,
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "check:portability": "python3 scripts/check-portability.py",
    "check:frontmatter": "node scripts/check-frontmatter.mjs",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byheaven/byheaven-skills.git"
  },
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./plugins/manager/skills"
    ],
    "extensions": [
      "./plugins/manager/.pi-plugin/user-rules.ts"
    ]
  },
  "bugs": {
    "url": "https://github.com/byheaven/byheaven-skills/issues"
  },
  "homepage": "https://github.com/byheaven/byheaven-skills#readme",
  "lint-staged": {
    "*.md": [
      "markdownlint-cli2 --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "yaml": "^2.9.1"
  }
}
